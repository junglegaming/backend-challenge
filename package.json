{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor — NestJS + MikroORM + PostgreSQL + SQS (LocalStack) on Bun",
  "type": "commonjs",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "sqs:setup": "bun scripts/setup-queues.ts",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "6.6.18",
    "@mikro-orm/migrations": "6.6.18",
    "@mikro-orm/postgresql": "6.6.18",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "pg": "^8.13.0",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "5.9.3"
  }
}
