{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "bun dist/src/main.js",
    "start:dev": "bun --watch src/main.ts",
    "migration:run": "bun x typeorm migration:run -d dist/src/database/data-source.js",
    "migration:revert": "bun x typeorm migration:revert -d dist/src/database/data-source.js",
    "test": "bun test ./test/domain.test.ts ./test/controller.test.ts ./test/integration/migrations.test.ts ./test/integration/concurrency.test.ts ./test/integration/multi-instance.test.ts",
    "test:integration": "bun test ./test/integration/migrations.test.ts ./test/integration/concurrency.test.ts ./test/integration/multi-instance.test.ts",
    "test:multi-instance": "bun test ./test/integration/multi-instance.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.yml\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.850.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^16.6.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/bun": "^1.2.18",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3"
  }
}
