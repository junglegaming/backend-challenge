# Local development against `docker compose -f docker-compose.test.yml up -d` (app on the host with Bun).
NODE_ENV=development
PORT=3000
APP_ROLES=api,consumer,outbox,pending-ref
LOG_LEVEL=info

# Runtime role (DML only) and schema owner (migrations only)
DATABASE_URL=postgres://wagering_app:app_dev_password@localhost:55432/wagering
DATABASE_MIGRATOR_URL=postgres://wagering_migrator:migrator_dev_password@localhost:55432/wagering
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000

# SQS emulator (MiniStack). MD5 verification off only because the emulator echoes the original MD5 on de-dup.
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:54566
SQS_VERIFY_MD5=false
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_S=30
# Apply the messages of one wallet from each receive in a single SQL transaction (ADR-14)
SQS_BATCH_PER_WALLET=true
# Currencies in which wallets may be opened (ISO-4217). A code that is not ISO-4217 fails the boot.
SUPPORTED_CURRENCIES=BRL,USD,EUR

# Pending-reference retry budget: 2s * 2^n, capped at 5 min, 10 attempts (~35 min)
PENDING_REF_BASE_MS=2000
PENDING_REF_MAX_MS=300000
PENDING_REF_MAX_ATTEMPTS=10

OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
