NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=wagering
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering

# AWS SQS (MiniStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://ministack:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo

# Workers & Concurrency
LOCK_TIMEOUT_MS=2000
SQS_MAX_RECEIVE_COUNT=5
PENDING_REF_MAX_ATTEMPTS=6
PENDING_REF_BASE_DELAY_MS=1000
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_LEASE_MS=10000

