
PORT=3000
# workers desta instância: consumer, outbox, pending-references (none = só HTTP)
WORKERS=consumer,outbox,pending-references
LOG_LEVEL=info
# true = aplica as migrations ao subir
RUN_MIGRATIONS=false

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000

# SQS
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_VISIBILITY_TIMEOUT_SECONDS=30
# tentativas antes de mandar a mensagem para a DLQ
SQS_MAX_ATTEMPTS=5
SQS_IMAGE=localstack/localstack:3.8

# outbox
OUTBOX_POLL_MS=500

# referências fora de ordem (PENDING_REFERENCE)
PENDING_REFERENCE_POLL_MS=1000
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_TTL_MS=600000
PENDING_REFERENCE_MAX_ATTEMPTS=30

# testes
# TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test
# SOMENTE para testes de falha: crash-after-commit-before-ack | crash-before-outbox-publish
# FAULT_INJECTION=
